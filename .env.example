NODE_ENV=development
SERVICE_NAME=operaon_identity
HOST=0.0.0.0
PORT=4700
TRUST_PROXY_HOPS=1

# PostgreSQL exclusivo do Identity
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operaon_identity
DB_USER=dbadmin
DB_PASSWORD=change-me
DB_SSL=false

# JWT: HS256 é aceitável apenas para desenvolvimento/testes.
# Em produção, prefira RS256/EdDSA com chaves gerenciadas e JWKS.
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-api
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Chave backend-a-backend recebida em X-Service-Key
SERVICE_API_KEY=replace-with-a-rotatable-secret

# Chave usada para cifrar o segredo TOTP em repouso
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-key

# CORS e segurança de senha
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# E-mail é opcional em desenvolvimento
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@operaon.local

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-identity
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
